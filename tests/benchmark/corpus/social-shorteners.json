{
  "category": "social-shorteners",
  "description": "Social-platform short-URL wrappers. t.co and link.medium.com are best-effort (path-based; engine can't follow HTTP redirects). When destination is clean, action=untouched.",
  "entries": [
    { "url": "https://exit.sc/?url=https%3A%2F%2Fexample.com%2Farticle", "expectedAction": "untouched", "expectedClean": "https://example.com/article", "notes": "Snap exit redirect — destination clean" },
    { "url": "https://t.co/abc123", "expectedAction": "untouched", "notes": "t.co path-only — registered for metrics, no extractor" },
    { "url": "https://t.co/xyz789?url=https%3A%2F%2Fexample.com%2Fpost", "expectedAction": "untouched", "expectedClean": "https://example.com/post", "notes": "t.co with query fallback (rare) — destination clean" },
    { "url": "https://link.medium.com/abc123def", "expectedAction": "untouched", "notes": "Medium short link — best-effort, no extractor when path-only" },
    { "url": "https://twitter.com/user/status/123?utm_source=share", "expectedAction": "cleaned", "expectedClean": "https://twitter.com/user/status/123" },
    { "url": "https://www.youtube.com/watch?v=abc123&feature=share&utm_source=youtube", "expectedAction": "cleaned", "notes": "Strips utm_source + feature" },
    { "url": "https://www.linkedin.com/feed/update/urn:li:activity:1234?utm_campaign=share", "expectedAction": "cleaned", "expectedClean": "https://www.linkedin.com/feed/update/urn:li:activity:1234" },
    { "url": "https://www.tiktok.com/@user/video/123?_t=ABC&_r=1", "expectedAction": "cleaned", "expectedClean": "https://www.tiktok.com/@user/video/123", "notes": "Both _r and _t stripped — _t added to universal TRACKING_PARAMS (platform_noise) in #508 (TikTok share token, not functional for the web URL)." },
    { "url": "https://www.facebook.com/share/p/abcdef/?mibextid=xxx", "expectedAction": "cleaned", "expectedClean": "https://www.facebook.com/share/p/abcdef/" },
    { "url": "https://www.instagram.com/p/ABC123/?igsh=xxx", "expectedAction": "cleaned", "expectedClean": "https://www.instagram.com/p/ABC123/" }
  ]
}
