# Pin muga rule artifacts to LF so the Ed25519 signature over
# wrappers.json verifies identically on Windows, macOS, and Linux. Without
# this, Windows checkouts with core.autocrlf=true would byte-modify the file
# at checkout and break verification.
src/rules/wrappers.json       text eol=lf
src/rules/wrappers.json.sig   text eol=lf
src/rules/worker-pubkey.txt   text eol=lf
src/rules/wrappers.data.js    text eol=lf
tools/rules-source/params.json text eol=lf

# web-cleaner-tool (#1029) generated engine artifacts: pin to LF so the
# byte-identity and deterministic-render mirror tests (web-engine-mirror.test.mjs)
# pass identically on Windows (core.autocrlf=true) and Linux CI. All of these
# are machine-generated by `npm run build:content` / `npm run build:web` and
# must never diverge by line ending from their in-memory rendering.
src/rules/domain-rules.json                text eol=lf
src/content/cleaner-bundle.js              text eol=lf
web/engine/cleaner-bundle.js               text eol=lf
web/engine/domain-rules.json               text eol=lf
web/engine/domain-rules.gen.mjs            text eol=lf
landing/clean/engine/cleaner-bundle.js     text eol=lf
landing/clean/engine/domain-rules.json     text eol=lf
landing/clean/engine/domain-rules.gen.mjs  text eol=lf
