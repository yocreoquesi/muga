{
  "compilerOptions": {
    "checkJs": true,
    "strict": false,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "allowJs": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0,
    "typeRoots": ["./types", "./node_modules/@types"],
    "types": ["node"]
  },
  "include": [
    "src/lib/**/*.js",
    "tools/**/*.mjs",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "landing",
    "landing-worker",
    "src/background",
    "src/content",
    "src/popup",
    "src/options",
    "src/onboarding",
    "tests"
  ]
}
